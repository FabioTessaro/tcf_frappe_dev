import { describe, expect, it, vi } from "vitest";

import { isChunkLoadError, reloadOnce } from "./error-handler";

describe("isChunkLoadError", () => {
  it("recognises failed lazy chunk loads", () => {
    expect(
      isChunkLoadError(new TypeError("Failed to fetch dynamically imported module: /x.js")),
    ).toBe(true);
    expect(isChunkLoadError(new Error("other"))).toBe(false);
    expect(isChunkLoadError("text")).toBe(false);
  });
});

describe("reloadOnce (FE-CACHE-003)", () => {
  it("reloads only the first time", () => {
    const reload = vi.fn();
    sessionStorage.clear();
    expect(reloadOnce(sessionStorage, reload)).toBe(true);
    expect(reloadOnce(sessionStorage, reload)).toBe(false);
    expect(reload).toHaveBeenCalledTimes(1);
  });
});
