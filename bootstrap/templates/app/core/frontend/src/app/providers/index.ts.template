import type { App } from "vue";

import { applyLanguage } from "@shared/i18n";

import { createPortalRouter } from "../router";

import { manifests } from "./app-registry";
import { installErrorHandler } from "./error-handler";
import { i18n } from "./i18n";
import { pinia } from "./pinia";

/** Install the providers in order: state, strings, routes, error handling. */
export function installProviders(app: App): void {
  const router = createPortalRouter(manifests);
  app.use(pinia);
  app.use(i18n);
  app.use(router);
  installErrorHandler(app, router);
  applyLanguage(i18n.global.locale.value);
}
