import type { RouteComponent, RouteRecordRaw } from "vue-router";

import type { AppManifest } from "@sdk";

/**
 * One lazy route subtree per app under its base path, in the app shell layout,
 * with the app's role metadata (FE-COMP-003, FE-COMP-007).
 */
export function appRoutes(
  manifests: readonly AppManifest[],
  layout: RouteComponent,
): RouteRecordRaw[] {
  return manifests.map((manifest) => ({
    path: manifest.basePath,
    component: layout,
    meta: { roles: manifest.roles, partyTypes: manifest.partyTypes },
    children: manifest.routes,
  }));
}
