@@# ---------------------------------------------------------------------------
@@# Template for docker-compose.yml — rendered by ./setup.sh and ./initialize.sh.
@@# Edit freely: image tags, ports, extra services… Re-run ./initialize.sh to
@@# apply (it re-renders the file and recreates only what changed).
@@#
@@# Available values:
@@#   @@COMPOSE_PROJECT_NAME@@  bootstrap/settings.conf
@@#   @@HOST_HOME@@             home directory of the user running the scripts
@@#   @@MEET_ENABLED@@          1 when the meet app is selected in .env
@@#   @@MARIADB_EXPOSE_PORT@@   1 when MariaDB should be published on the host
@@#   @@SITE_NAME@@ @@TEST_SITE_NAME@@ @@TEST_MINIMAL_SITE_NAME@@  from .env
@@#
@@# ${VAR} values (not @@…@@) are filled in by docker compose from .env when the
@@# containers start, so secrets never end up in docker-compose.yml itself.
@@# ---------------------------------------------------------------------------
# =============================================================================
# GENERATED by frappe-dev from bootstrap/templates/docker-compose.yml.template
# Do not edit here — edit the template and re-run ./initialize.sh.
# =============================================================================
name: @@COMPOSE_PROJECT_NAME@@

services:
  mariadb:
    image: docker.io/mariadb:11.8
    restart: unless-stopped
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
      - --skip-innodb-read-only-compressed
    volumes:
      - mariadb-data:/var/lib/mysql
    env_file:
      - .env
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 5s
      retries: 60
@@IF MARIADB_EXPOSE_PORT@@
    ports:
      - "3306:3306"
@@ENDIF MARIADB_EXPOSE_PORT@@

  redis-cache:
    image: docker.io/redis:alpine
    restart: unless-stopped

  redis-queue:
    image: docker.io/redis:alpine
    restart: unless-stopped

  seaweedfs:
    image: docker.io/chrislusf/seaweedfs:latest
    restart: unless-stopped
    # -master.telemetry=false: no usage statistics sent to telemetry.seaweedfs.com.
    command: "server -s3 -webdav -dir=/data -ip.bind=0.0.0.0 -master.telemetry=false"
    # The S3 API requires the keys from .env (SeaweedFS creates an admin
    # identity from these variables); anonymous S3 requests are refused.
    environment:
      - AWS_ACCESS_KEY_ID=${SEAWEEDFS_ACCESS_KEY}
      - AWS_SECRET_ACCESS_KEY=${SEAWEEDFS_SECRET_KEY}
    ports:
      - "9333:9333"   # master
      - "8888:8888"   # filer
      - "8333:8333"   # S3
      - "8080:8080"   # volume
      - "7333:7333"   # WebDAV
    volumes:
      - seaweedfs-data:/data
    env_file:
      - .env

  # Antivirus (clamd on port 3310, reachable as clamav:3310 from the other
  # containers; not published on the host). The image ships with signatures;
  # freshclam keeps them up to date in the clamav-db volume. clamd answers
  # about 15-60 s after start and needs about 1.5 GB of RAM.
  clamav:
    image: docker.io/clamav/clamav:latest
    restart: unless-stopped
    volumes:
      - clamav-db:/var/lib/clamav
@@IF MEET_ENABLED@@

  meet-sfu:
    image: ghcr.io/frappe/meet/sfu-server:latest
    restart: unless-stopped
    env_file:
      - .env
    environment:
      - HOST=0.0.0.0
      - PORT=3000
      - MEDIASOUP_LISTEN_IP=0.0.0.0
      - WEBRTC_LISTEN_IP=0.0.0.0
      # Upstream default is 40000-49999; narrowed to keep the published port
      # list small. Widen both this and `ports:` for more participants.
      - RTC_MIN_PORT=40000
      - RTC_MAX_PORT=40099
    ports:
      - "3000:3000"
      - "40000-40099:40000-40099/udp"
@@ENDIF MEET_ENABLED@@

  frappe:
    image: docker.io/frappe/bench:latest
    restart: unless-stopped
    command: sleep infinity
    env_file:
      - .env
    environment:
      - SHELL=/bin/bash
      - CLAUDE_CONFIG_DIR=/home/frappe/.claude
      # Accept new SSH host keys automatically (custom-app clones run unattended).
      - GIT_SSH_COMMAND=ssh -o StrictHostKeyChecking=accept-new
    volumes:
      - .:/workspace:cached
      - @@HOST_HOME@@/.ssh:/home/frappe/.ssh:cached
      - @@HOST_HOME@@/.gitconfig:/home/frappe/.gitconfig:ro
      - vscode-server:/home/frappe/.vscode-server
      - claude-config:/home/frappe/.claude
    working_dir: /workspace
    # Every site resolves to the container itself (Playwright, bench run-tests…).
    extra_hosts:
      - "@@SITE_NAME@@:127.0.0.1"
      - "@@TEST_SITE_NAME@@:127.0.0.1"
      - "@@TEST_MINIMAL_SITE_NAME@@:127.0.0.1"
    depends_on:
      - mariadb
      - redis-cache
      - redis-queue
      - seaweedfs
      - clamav
    ports:
      - "8000-8005:8000-8005"   # bench web server
      - "9000-9005:9000-9005"   # socket.io
      - "6787:6787"             # file watcher
      - "5173:5173"             # Vite development server

volumes:
  mariadb-data:
  seaweedfs-data:
  clamav-db:
  vscode-server:
  claude-config:
