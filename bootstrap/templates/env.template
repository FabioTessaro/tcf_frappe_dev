@@# ---------------------------------------------------------------------------
@@# Template for .env — rendered by ./setup.sh.
@@# Placeholders: @@KEY@@ (values arrive already single-quoted).
@@# Conditional blocks: @@IF KEY@@ … @@ENDIF KEY@@ / @@IFNOT KEY@@ … @@ENDIF KEY@@
@@# Lines starting with "@@#" (like these) are not copied into .env.
@@# ---------------------------------------------------------------------------
# =============================================================================
# frappe-dev environment — generated by ./setup.sh on @@GENERATED_AT@@
# =============================================================================
# Edit with ./setup.sh (it validates values and tells you what has to be
# re-initialized). Hand edits work too, but are overwritten on the next save.
# Contains secrets: never commit this file.
# =============================================================================

# --- Sites -------------------------------------------------------------------
SITE_NAME=@@SITE_NAME@@
TEST_SITE_NAME=@@TEST_SITE_NAME@@
# Minimal test site: Frappe + the core app only (install the app under test
# and its hard dependencies on it when needed).
TEST_MINIMAL_SITE_NAME=@@TEST_MINIMAL_SITE_NAME@@
# Developer mode on the main site (the test site always has it on).
MAIN_SITE_DEVELOPER_MODE=@@MAIN_SITE_DEVELOPER_MODE@@
ADMIN_PASSWORD=@@ADMIN_PASSWORD@@

# --- MariaDB -----------------------------------------------------------------
MARIADB_ROOT_USERNAME=@@MARIADB_ROOT_USERNAME@@
MARIADB_ROOT_PASSWORD=@@MARIADB_ROOT_PASSWORD@@
MARIADB_AUTO_UPGRADE='1'
# Publish MariaDB's port 3306 on the host (for DBeaver & co.): 1 or 0.
MARIADB_EXPOSE_PORT=@@MARIADB_EXPOSE_PORT@@

# --- SeaweedFS (S3 storage) --------------------------------------------------
SEAWEEDFS_ENDPOINT='http://seaweedfs:8333'
SEAWEEDFS_ACCESS_KEY=@@SEAWEEDFS_ACCESS_KEY@@
SEAWEEDFS_SECRET_KEY=@@SEAWEEDFS_SECRET_KEY@@
# Buckets created by ./initialize.sh (space separated; never deleted automatically).
SEAWEEDFS_BUCKETS=@@SEAWEEDFS_BUCKETS@@

# --- ClamAV (antivirus) ------------------------------------------------------
# clamd inside the compose network; written into every site's site_config.json.
CLAMAV_HOST='clamav'
CLAMAV_PORT='3310'

# --- Frappe and default apps (git tag or branch) -----------------------------
FRAPPE_VERSION=@@FRAPPE_VERSION@@
# Default apps to install, in install order (dependencies first).
DEFAULT_APPS=@@DEFAULT_APPS@@
@@APP_VERSIONS@@
@@IF MEET_ENABLED@@

# --- Meet SFU (only because the meet app is selected) ------------------------
JWT_SECRET=@@JWT_SECRET@@
WEBRTC_ANNOUNCED_IP=@@MEET_ANNOUNCED_IP@@
MEDIASOUP_ANNOUNCED_IP=@@MEET_ANNOUNCED_IP@@
@@ENDIF MEET_ENABLED@@

# --- Custom apps -------------------------------------------------------------
# Where the repositories live: ./new-platform.sh and ./new-app.sh create them
# there, ./initialize.sh clones every app from <prefix>/<app>.git.
CUSTOM_APPS_GIT_PREFIX=@@CUSTOM_APPS_GIT_PREFIX@@
# App names, core app first; empty until ./new-app.sh creates the first app
# (it adds every app it creates).
CUSTOM_APPS=@@CUSTOM_APPS@@
# Per-app URL overrides ("app=url app2=url2"); others use <prefix>/<app>.git
CUSTOM_APP_URLS=@@CUSTOM_APP_URLS@@
CORE_APP=@@CORE_APP@@

# --- Platform repository (./new-platform.sh) -------------------------------------
# Cloned into ./platform by ./initialize.sh when missing; empty = none yet.
PLATFORM_URL=@@PLATFORM_URL@@
