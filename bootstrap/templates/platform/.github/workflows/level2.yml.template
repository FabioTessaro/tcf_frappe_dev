# Level 2 (guide 501): on every change to platform.lock or the image, on main,
# and nightly. If ci-image/Dockerfile changed in the same push, the CI image may
# still be publishing: re-run the job.
name: level2

on:
  pull_request:
    paths: [platform.lock, docker/**, compose/**, tools/**]
  push:
    branches: [main]
  schedule:
    - cron: "0 3 * * *"
  workflow_dispatch:

permissions:
  contents: read
  packages: write

jobs:
  level2:
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/@@OWNER@@/ci:@@CI_TAG@@
      credentials:
        username: ${{ github.actor }}
        password: ${{ secrets.GITHUB_TOKEN }}
      options: --user root
      volumes:
        - /var/run/docker.sock:/var/run/docker.sock
    env:
      APPS_READ_TOKEN: ${{ secrets.APPS_READ_TOKEN }}
      COSIGN_PRIVATE_KEY: ${{ github.ref == 'refs/heads/main' && secrets.COSIGN_PRIVATE_KEY || '' }}
      COSIGN_PASSWORD: ${{ secrets.COSIGN_PASSWORD }}
    steps:
      - uses: actions/checkout@@@CHECKOUT_SHA@@ # @@CHECKOUT_TAG@@
      - name: Log in to ghcr.io
        run: echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u "${{ github.actor }}" --password-stdin
      - run: just level2
      - if: github.ref == 'refs/heads/main'
        run: just sign
