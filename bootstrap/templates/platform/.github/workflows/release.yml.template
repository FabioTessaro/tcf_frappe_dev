# Platform release (guide 502): signed image, SBOM, notes, git tag.
name: release

on:
  workflow_dispatch:
    inputs:
      version:
        description: Platform version (YYYY.MM.PATCH)
        required: true

permissions:
  contents: write
  packages: write

jobs:
  release:
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/@@OWNER@@/ci:@@CI_TAG@@
      credentials:
        username: ${{ github.actor }}
        password: ${{ secrets.GITHUB_TOKEN }}
      options: --user root
      volumes:
        - /var/run/docker.sock:/var/run/docker.sock
    env:
      APPS_READ_TOKEN: ${{ secrets.APPS_READ_TOKEN }}
      COSIGN_PRIVATE_KEY: ${{ secrets.COSIGN_PRIVATE_KEY }}
      COSIGN_PASSWORD: ${{ secrets.COSIGN_PASSWORD }}
    steps:
      - uses: actions/checkout@@@CHECKOUT_SHA@@ # @@CHECKOUT_TAG@@
        with:
          fetch-depth: 0
      - name: Log in to ghcr.io
        run: echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u "${{ github.actor }}" --password-stdin
      - run: just release "${{ inputs.version }}"
