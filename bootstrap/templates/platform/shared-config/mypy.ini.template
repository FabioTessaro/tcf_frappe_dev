# Shared mypy configuration (DEL-TOOL-003) — copied by `just sync-config`; do
# not edit the copy. Strict for all code (504: sdk, service.py, schemas.py must
# pass strict; strict everywhere is the stricter choice).
[mypy]
python_version = 3.14
plugins = pydantic.mypy
strict = True
warn_unreachable = True

[pydantic-mypy]
init_forbid_extra = True
init_typed = True
warn_required_dynamic_aliases = True

# Frappe ships no type information.
[mypy-frappe.*]
ignore_missing_imports = True
