@@# ---------------------------------------------------------------------------
@@# Keys merged into the TEST site's site_config.json (test.<site>) by
@@# ./initialize.sh on every run. The test site is meant for automated tests
@@# (Playwright, bench run-tests): developer mode and allow_tests are always on.
@@# Same values as main.json.template.
@@# ---------------------------------------------------------------------------
{
  "developer_mode": 1,
  "allow_tests": true,
@@IF MEET_ENABLED@@
  "sfu_secret": "@@JWT_SECRET@@",
  "sfu_server_url": "http://@@MEET_ANNOUNCED_IP@@",
  "sfu_server_port": 3000,
@@ENDIF MEET_ENABLED@@
  "seaweedfs_endpoint": "@@SEAWEEDFS_ENDPOINT@@",
  "seaweedfs_access_key": "@@SEAWEEDFS_ACCESS_KEY@@",
  "seaweedfs_secret_key": "@@SEAWEEDFS_SECRET_KEY@@"
}
